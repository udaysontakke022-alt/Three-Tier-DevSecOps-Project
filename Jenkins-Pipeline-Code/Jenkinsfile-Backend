
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-southeast-2'
        IMAGE_NAME = 'three-tier-backend'
        BACKEND_DIR = 'Application-Code/backend'
    }

    stages {
        stage('Checkout from GitHub') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/udaysontakke022-alt/Three-Tier-DevSecOps-Project.git'
            }
        }

        stage('Verify Backend Project') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        echo "Checking backend files..."
                        ls -la
                        test -f Dockerfile
                    '''
                }
            }
        }

        stage('Check Build Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    docker --version
                    java -version
                    mvn -version
                '''
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            if ! command -v npm >/dev/null 2>&1; then
                                echo "ERROR: Node.js/npm is required."
                                exit 1
                            fi
                            npm ci
                        elif [ -f package.json ]; then
                            if ! command -v npm >/dev/null 2>&1; then
                                echo "ERROR: Node.js/npm is required."
                                exit 1
                            fi
                            npm install
                        elif [ -f pom.xml ]; then
                            mvn -B -DskipTests package
                        else
                            echo "No supported dependency manifest found."
                        fi
                    '''
                }
            }
        }

        
stage('Run Backend Tests') {
    steps {
        dir("${BACKEND_DIR}") {
            sh '''
                set -eu

                if [ -f package.json ]; then
                    node -e "
                        const p = require('./package.json');
                        const test = p.scripts && p.scripts.test;
                        process.exit(
                            test && !test.includes('no test specified')
                                ? 0 : 1
                        );
                    " && HAS_TESTS=true || HAS_TESTS=false

                    if [ "$HAS_TESTS" = "true" ]; then
                        CI=true npm test
                    else
                        echo "WARNING: No real backend tests configured."
                        echo "Skipping placeholder npm test script."
                    fi

                elif [ -f pom.xml ]; then
                    mvn -B test
                else
                    echo "WARNING: No test configuration found."
                fi
            '''
        }
    }
}
