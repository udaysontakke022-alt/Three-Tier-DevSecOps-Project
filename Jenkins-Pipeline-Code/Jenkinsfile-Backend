
pipeline {
    agent any

    tools {
        jdk 'jdk21'
        nodejs 'nodejs'
    }

    environment {
        AWS_REGION = 'ap-southeast-2'
        AWS_ACCOUNT_ID = '109991964488'

        ECR_REPOSITORY = 'three-tier-backend'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE_NAME = 'three-tier-backend'
        IMAGE_TAG = "${BUILD_NUMBER}"

        SONAR_PROJECT_KEY = 'Three-Tier-Backend'
        SCANNER_HOME = tool 'sonar-scanner'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout GitHub') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/udaysontakke022-alt/Three-Tier-DevSecOps-Project.git'
            }
        }

        stage('Verify Backend Project') {
            steps {
                dir('Application-Code/backend') {
                    sh '''
                        set -eu

                        echo "Checking backend files..."

                        test -f package.json
                        test -f package-lock.json
                        test -f Dockerfile
                        test -f index.js

                        echo "Backend files verified."
                    '''
                }
            }
        }

        stage('Check Installed Tools') {
            steps {
                sh '''
                    set -eu

                    echo "Checking installed tools..."

                    node --version
                    npm --version
                    docker --version
                    trivy --version
                    aws --version

                    echo "All required tools checked."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Application-Code/backend') {
                    sh '''
                        set -eu
                        npm ci
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    dir('Application-Code/backend') {
                        sh '''
                            "$SCANNER_HOME/bin/sonar-scanner" \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.projectName="Three-Tier-Backend" \
                              -Dsonar.sources=. \
                              -Dsonar.exclusions=node_modules/**,coverage/**
                        '''
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    trivy fs \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      --output trivy-fs-report.txt \
                      Application-Code/backend
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Application-Code/backend') {
                    sh '''
                        set -eu

                        docker build \
                          -t "${IMAGE_NAME}:${IMAGE_TAG}" \
                          .
                    '''
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker image inspect \
                      "${IMAGE_NAME}:${IMAGE_TAG}"

                    echo "Docker image verified."
                '''
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      --output trivy-image-report.txt \
                      "${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Push Docker Image to AWS ECR') {
            steps {
                sh '''
                    set -eu

                    echo "Verifying AWS identity..."
                    aws sts get-caller-identity

                    echo "Logging in to AWS ECR..."
                    aws ecr get-login-password \
                      --region "$AWS_REGION" | \
                      docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"

                    echo "Tagging Docker image..."
                    docker tag \
                      "${IMAGE_NAME}:${IMAGE_TAG}" \
                      "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "Pushing Docker image..."
                    docker push \
                      "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "Docker image pushed successfully."
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivy-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Backend CI pipeline completed successfully.'
            echo "Image pushed to ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
        }

        failure {
            echo 'Backend CI pipeline failed. Check Console Output.'
        }
    }
}
