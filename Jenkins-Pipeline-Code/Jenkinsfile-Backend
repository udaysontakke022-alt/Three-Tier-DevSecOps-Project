
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-southeast-2'
        IMAGE_NAME = 'three-tier-backend'
        BACKEND_DIR = 'Application-Code/backend'
    }

    stages {
        stage('Checkout from GitHub') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/udaysontakke022-alt/Three-Tier-DevSecOps-Project.git'
            }
        }

        stage('Verify Backend Project') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        echo "Checking backend files..."
                        ls -la
                        test -f Dockerfile
                    '''
                }
            }
        }

        stage('Check Build Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    docker --version
                    java -version
                    mvn -version
                '''
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            if ! command -v npm >/dev/null 2>&1; then
                                echo "ERROR: Node.js/npm is required."
                                exit 1
                            fi
                            npm ci
                        elif [ -f package.json ]; then
                            if ! command -v npm >/dev/null 2>&1; then
                                echo "ERROR: Node.js/npm is required."
                                exit 1
                            fi
                            npm install
                        elif [ -f pom.xml ]; then
                            mvn -B -DskipTests package
                        else
                            echo "No supported dependency manifest found."
                        fi
                    '''
                }
            }
        }

        stage('Run Backend Tests') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        if [ -f package.json ]; then
                            if node -e "const p=require('./package.json'); process.exit(p.scripts && p.scripts.test ? 0 : 1)"; then
                                CI=true npm test
                            else
                                echo "No npm test script; skipping."
                            fi
                        elif [ -f pom.xml ]; then
                            mvn -B test
                        else
                            echo "No supported test configuration found."
                        fi
                    '''
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        if command -v trivy >/dev/null 2>&1; then
                            trivy fs --scanners vuln,secret \
                                --exit-code 0 \
                                --format table . > trivyfs.txt
                        else
                            echo "Trivy not installed; scan skipped."
                        fi
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        docker build \
                            -t "${IMAGE_NAME}:${BUILD_NUMBER}" .
                    '''
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    docker image inspect \
                        "${IMAGE_NAME}:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh '''
                    if command -v trivy >/dev/null 2>&1; then
                        trivy image --exit-code 0 \
                            "${IMAGE_NAME}:${BUILD_NUMBER}" \
                            > trivyimage.txt
                    else
                        echo "Trivy not installed; scan skipped."
                    fi
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: '**/trivyfs.txt,trivyimage.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Backend CI pipeline completed successfully.'
        }

        failure {
            echo 'Backend CI pipeline failed. Check console output.'
        }
    }
}
