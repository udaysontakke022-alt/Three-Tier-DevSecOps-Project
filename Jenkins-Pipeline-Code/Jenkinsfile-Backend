
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        BACKEND_DIR = 'Application-Code/backend'
        IMAGE_NAME = 'three-tier-backend'
    }

    stages {

        stage('Checkout from GitHub') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/udaysontakke022-alt/Three-Tier-DevSecOps-Project.git'
            }
        }

        stage('Verify Backend Project') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        echo "Checking backend files..."
                        ls -la
                        test -f Dockerfile
                        test -f package.json
                        echo "Backend project verified."
                    '''
                }
            }
        }

        stage('Check Build Tools') {
            steps {
                sh '''
                    set -eu
                    git --version
                    docker --version
                    node --version
                    npm --version
                    java -version
                    mvn -version
                    trivy --version
                '''
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi
                    '''
                }
            }
        }

        stage('Run Backend Tests') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu

                        if node -e "
                            const p = require('./package.json');
                            const t = p.scripts && p.scripts.test;
                            process.exit(
                                t && !t.includes('no test specified')
                                    ? 0 : 1
                            );
                        "; then
                            npm test
                        else
                            echo "WARNING: No real backend tests configured."
                            echo "Skipping placeholder npm test."
                        fi
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${BACKEND_DIR}") {
                    script {
                        def scannerHome = tool 'sonar-scanner'

                        withSonarQubeEnv('sonar-server') {
                            sh """
                                "${scannerHome}/bin/sonar-scanner" \
                                    -Dsonar.projectKey=Three-Tier-Backend \
                                    -Dsonar.projectName=Three-Tier-Backend \
                                    -Dsonar.sources=. \
                                    -Dsonar.exclusions=node_modules/**,coverage/**
                            """
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        trivy fs \
                            --scanners vuln,secret \
                            --exit-code 0 \
                            --format table \
                            --output trivyfs.txt \
                            .
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh '''
                        set -eu
                        docker build \
                            -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker image inspect \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                        --exit-code 0 \
                        --format table \
                        --output trivyimage.txt \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend CI Pipeline completed successfully.'
        }

        failure {
            echo 'Backend CI Pipeline failed. Check console output.'
        }

        always {
            archiveArtifacts artifacts: '**/trivyfs.txt,**/trivyimage.txt',
                             allowEmptyArchive: true
        }
    }
}
